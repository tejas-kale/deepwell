<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key><string>en</string>
	<key>CFBundleDisplayName</key><string>Deepwell</string>
	<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key><string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key><true/>
	<key>ITSAppUsesNonExemptEncryption</key><false/>
	<!-- Speech: the phone times each narrated word on device (ticket 17: SpeechAnalyzer, falling back to
	     SFSpeechRecognizer); podcasts are still transcribed on the Mac. Without it processing rejects the build (ITMS-90683). -->
	<key>NSSpeechRecognitionUsageDescription</key><string>Deepwell recognises its own narration on this device to highlight each word as it is read. Podcasts are transcribed on your Mac.</string>
	<!-- Ticket 17 links MediaPlayer (Now Playing and lock-screen controls only; no media library access). Declared so
	     a static scan of the linked framework can't reject the build for a missing purpose string. -->
	<key>NSAppleMusicUsageDescription</key><string>Deepwell doesn't read your music library. It only shows what it is reading aloud on the lock screen.</string>
	<key>DeepwellAppGroup</key><string>group.com.tejaskale.deepwell</string>
	<!-- Ticket 16: the keychain-access-groups entry both apps carry; synced API keys live there. -->
	<key>DeepwellKeychainGroup</key><string>$(AppIdentifierPrefix)com.tejaskale.deepwell</string>
	<!-- Ticket 16: tagging what this device captured, when the app is backgrounded (BGProcessingTask). -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.tejaskale.deepwell.tagging</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<!-- Ticket 17: Listen keeps playing (and generating ahead) with the screen locked. -->
		<string>audio</string>
		<string>processing</string>
	</array>
	<key>UILaunchScreen</key><dict/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key><true/>
	</dict>
	<!-- Every orientation on iPad (and no UIRequiresFullScreen) so Split View and Slide Over work. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Same container and public name as the Mac app (docs/storage.md): Files shows it as iCloud Drive › Deepwell. -->
	<key>NSUbiquitousContainers</key>
	<dict>
		<key>iCloud.com.tejaskale.deepwell</key>
		<dict>
			<key>NSUbiquitousContainerIsDocumentScopePublic</key><true/>
			<key>NSUbiquitousContainerName</key><string>Deepwell</string>
			<key>NSUbiquitousContainerSupportedFolderLevels</key><string>Any</string>
		</dict>
	</dict>
</dict>
</plist>
