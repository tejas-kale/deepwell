{
  "manifest_version": 3,
  "name": "Deepwell",
  "description": "Save the current page to your Deepwell library as Markdown.",
  "version": "0.1.0",
  "icons": { "48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png" },
  "background": { "scripts": ["background.js"], "persistent": false },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["readability.js", "turndown.js", "turndown-plugin-gfm.js", "extract.js", "youtube.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Save to Deepwell",
    "default_icon": { "16": "icon-16.png", "32": "icon-32.png" }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+S", "mac": "MacCtrl+Shift+S" },
      "description": "Save the current tab to Deepwell"
    }
  },
  "permissions": ["nativeMessaging", "activeTab"]
}
